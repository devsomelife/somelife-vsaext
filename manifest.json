{
  "manifest_version": 3,
  "name": "VSA Ext",
  "version": "0.1.0",
  "description": "Readable selects and shadow tracking for VSA timesheets.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://vsa.example.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "VSA Ext",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://vsa.example.com/o_services/timesheetspivot/*"
      ],
      "js": [
        "src/content/selectors.js",
        "src/content/widen.js",
        "src/content/inject.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/widen.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}